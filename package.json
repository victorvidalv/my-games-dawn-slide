{
  "name": "slide-and-slay",
  "version": "48.0.0",
  "private": true,
  "type": "module",
  "description": "DAWNSLIDE: puzle de bloques roguelite con tres héroes y 21 niveles (PWA).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:full": "FULL=1 vitest run",
    "test:fresh": "TEST_CACHE=0 vitest run",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts vite.config.js vitest.config.js eslint.config.js",
    "format:check": "prettier --check src tests scripts vite.config.js vitest.config.js eslint.config.js",
    "levels": "node scripts/generate-levels.mjs",
    "levels:decorate": "node scripts/decorate-levels.mjs",
    "levels:walls": "node scripts/generate-walls.mjs",
    "levels:special": "npm run levels:walls && npm run levels:decorate",
    "levels:all": "npm run levels && npm run levels:special",
    "simulate": "node scripts/simulate-heroes.mjs",
    "balance": "node scripts/analyze-balance.mjs",
    "melodies:html": "node scripts/build-melodies.mjs",
    "calibrator": "node tools/calibrator/server.mjs",
    "calibrate": "node scripts/calibrate.mjs"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
